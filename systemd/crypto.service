[Unit]
Description=Spike crypto scanner (Binance, 24/7)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/spike
Environment=PATH=/home/ubuntu/spike/venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/ubuntu/spike/.env
ExecStart=/home/ubuntu/spike/venv/bin/python -m spike.crypto_main
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto

[Install]
WantedBy=multi-user.target
