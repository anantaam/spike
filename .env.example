# Copy to .env and fill in. All historical/live data is backfilled and
# maintained entirely by spike itself (data_cache/) -- no other project's
# files are read. The only optional reuse is the Kite session below, purely
# as a startup-time optimization.

# --- Kite session reuse (optional: read another project's live token so spike
# doesn't need its own login round-trip at startup) ---
# Point at a sibling project's persisted token file. Leave unset/nonexistent
# for a fully standalone deployment -- spike will log in itself using the
# KITE_* creds below (and persist its own token from then on).
SPIKE_KITE_TOKEN_FILE=/home/ubuntu/orb/state/live/kite_token.json
SPIKE_KITE_TOKEN_MAX_AGE_HOURS=20

# --- Kite creds (used for spike's own login whenever no reusable token is found --
# always required on a box with no sibling project) ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# --- Alerting ---
SPIKE_DISCORD_WEBHOOK_URL=

# --- Scan config ---
# Comma-separated timeframes to scan live.
SPIKE_TIMEFRAMES=5min,15min,1h,1D

# Comma-separated ticker override. Empty = auto-discover current F&O
# underlyings from kite.instruments().
SPIKE_UNIVERSE=

# --- Paths (defaults are fine for a single-instance deployment) ---
SPIKE_STATE_DIR=
SPIKE_CACHE_DIR=

# --- crypto scanner (Binance public API -- no key needed) ---
SPIKE_CRYPTO_DISCORD_WEBHOOK_URL=
# SPIKE_CRYPTO_UNIVERSE=BTCUSDT,ETHUSDT,XRPUSDT,SOLUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,SUIUSDT,PEPEUSDT
# SPIKE_CRYPTO_MIN_RISK_PCT=0.5
