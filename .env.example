# Copy to .env and fill in. Every var has a sensible default for THIS box
# (reusing ORB's session/data); override for a standalone deployment.

# --- Kite session reuse (fast path: read another project's live token) ---
# Point at a sibling project's persisted token file. Leave unset/nonexistent
# on a standalone box -- spike will fall back to logging in itself using the
# KITE_* creds below.
SPIKE_KITE_TOKEN_FILE=/home/ubuntu/orb/state/live/kite_token.json
SPIKE_KITE_TOKEN_MAX_AGE_HOURS=20

# --- Kite creds for an INDEPENDENT login (only used if no reusable token found) ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# --- Historical 1-min data reuse (fast path: read another project's local cache) ---
# Leave pointed at a nonexistent path on a standalone box -- spike backfills
# its own cache (data_cache/) via kite.historical_data() automatically.
SPIKE_EXTERNAL_DATA_DIR=/home/ubuntu/orb/data

# --- Alerting ---
SPIKE_DISCORD_WEBHOOK_URL=

# --- Scan config ---
# Comma-separated timeframes to scan live. 1D needs its own deeper backfill --
# only add it once you've confirmed enough daily history is cached.
SPIKE_TIMEFRAMES=5min,15min,1h

# Comma-separated ticker override. Empty = auto-discover current F&O
# underlyings from kite.instruments().
SPIKE_UNIVERSE=

# --- Paths (defaults are fine for a single-instance deployment) ---
SPIKE_STATE_DIR=
SPIKE_CACHE_DIR=
